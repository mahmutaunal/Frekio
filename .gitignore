# -----------------------------------------------------------------------------
# Android / Gradle
# -----------------------------------------------------------------------------
android/.gradle/
android/.cxx/
android/captures/
android/local.properties
android/key.properties
android/app/debug/
android/app/profile/
android/app/release/
*.apk
*.aab
*.apks

# Signing keys and certificates must never be committed.
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
*.cer
*.der

# -----------------------------------------------------------------------------
# Apple platforms / Xcode
# -----------------------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/*.xccheckout
ios/**/*.moved-aside
DerivedData/
*.xcarchive

# Keep shared Xcode schemes, workspace settings, project files, entitlements,
# and Swift Package resolution under version control.

# -----------------------------------------------------------------------------
# Local configuration, secrets, and generated service files
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local
secrets.*
*.secret
google-services.json
GoogleService-Info.plist

